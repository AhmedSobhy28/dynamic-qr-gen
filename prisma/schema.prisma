generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QrCode {
  id          String   @id @default(uuid())
  shortCode   String   @unique
  originalUrl String   
  title       String?  
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}